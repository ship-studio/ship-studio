{
  "name": "ship-studio",
  "private": true,
  "version": "1.6.3",
  "packageManager": "pnpm@9.15.9",
  "description": "Ship Studio — a desktop app for shipping web projects with AI coding agents.",
  "license": "MIT",
  "homepage": "https://github.com/ship-studio/ship-studio#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ship-studio/ship-studio.git"
  },
  "bugs": {
    "url": "https://github.com/ship-studio/ship-studio/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "harness": "vite --config vite.harness.config.ts",
    "harness:capture": "node scripts/harness-capture.mjs --all",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:scripts": "node --test scripts/*.test.mjs",
    "clean": "rm -rf dist",
    "clean:rust": "cd src-tauri && cargo clean",
    "clean:all": "pnpm clean && rm -rf node_modules && pnpm clean:rust",
    "lint": "eslint src --report-unused-disable-directives",
    "lint:strict": "eslint src --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "icons:status": "node scripts/icons.mjs status",
    "icons:check": "node scripts/icons.mjs check",
    "docs:generate": "node scripts/design-system-registry.mjs generate",
    "docs:check": "node scripts/design-system-registry.mjs check",
    "check:tokens": "node --test scripts/check-css-tokens.test.mjs scripts/token-inventory.test.mjs",
    "tokens:inventory": "node scripts/token-inventory.mjs",
    "check:token-layers": "node scripts/token-inventory.mjs --check",
    "check:css-ownership": "node scripts/check-css-ownership.mjs",
    "check:inline-styles": "node scripts/check-inline-styles.mjs",
    "typecheck": "tsc --noEmit",
    "rust:fmt": "cd src-tauri && cargo fmt",
    "rust:fmt:check": "cd src-tauri && cargo fmt -- --check",
    "rust:clippy": "cd src-tauri && cargo clippy -- -A clippy::uninlined_format_args",
    "rust:clippy:strict": "cd src-tauri && cargo clippy -- -D warnings",
    "rust:test": "cd src-tauri && cargo test",
    "check:all": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm rust:fmt:check && pnpm rust:clippy && pnpm test:scripts && pnpm docs:check && pnpm check:patterns && pnpm check:loc && pnpm check:ui-baseline",
    "check:patterns": "bash scripts/check-patterns.sh",
    "check:loc": "bash scripts/check-loc-limits.sh",
    "check:ui-baseline": "bash scripts/check-ui-baseline.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@sentry/react": "^10.76.2",
    "@tauri-apps/api": "~2.9.1",
    "@tauri-apps/plugin-dialog": "~2.6.0",
    "@tauri-apps/plugin-fs": "~2.4.5",
    "@tauri-apps/plugin-opener": "~2.5.3",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.9.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "culori": "^4.0.2",
    "dompurify": "^3.4.17",
    "marked": "^17.0.6",
    "overlayscrollbars": "^2.17.0",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-github-calendar": "^5.0.9",
    "tailwind-merge": "^3.7.0",
    "tauri-plugin-screenshots-api": "^2.2.0",
    "tauri-pty": "^0.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@tauri-apps/cli": "~2.9.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "~7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "~3.8.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "~8.54.0",
    "vite": "^7.3.7",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.12"
  }
}
