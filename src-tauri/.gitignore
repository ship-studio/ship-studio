# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# The vendored PTY plugin builds standalone when its tests are run directly
# (CI does this, since it is a path dependency and not a workspace member),
# which leaves a target dir and a lockfile of its own beside it.
/plugins/*/target/
/plugins/*/Cargo.lock
